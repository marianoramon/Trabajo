' =====================================================================
'  BUSCADOR CAD - INDICE DE BUSQUEDA - v7.9
' =====================================================================
'
'  Cambios v7.9:
'    - La busqueda se lanza sola al teclear (350 ms). Ya no depende de Intro,
'      que Inventor se traga en formularios no modales.
'    - Cabecera propia con botones Minimizar, Maximizar y Cerrar. Cerrar ya no
'      depende de la tecla Escape.
'    - Escape e Intro se cablean por cuatro vias distintas por si Inventor los
'      suelta: ProcessCmdKey, ProcessDialogKey, KeyDown del formulario e
'      IMessageFilter.
'    - Al relanzar la regla se activa la ventana ya abierta en vez de duplicarla.
'    - Interfaz rehecha en una sola pasada, con acento ambar en las acciones
'      principales y la paleta oscura de siempre.
'
'  Modos de indexado:
'    - Rapido: solo nombre (no necesita Inventor)
'    - Relaciones: proceso aparte en segundo plano que lee los ensamblajes
'
' =====================================================================

Sub Main()
    Try
        If BuscadorFicherosForm.Instancia IsNot Nothing AndAlso _
                Not BuscadorFicherosForm.Instancia.IsDisposed Then
            BuscadorFicherosForm.Instancia.Activate()
            Return
        End If
    Catch
    End Try

    Dim frm As New BuscadorFicherosForm(ThisApplication)
    BuscadorFicherosForm.Instancia = frm
    Try
        frm.Show(New VentanaInventor(New System.IntPtr( _
            System.Convert.ToInt64(ThisApplication.MainFrameHWND))))
    Catch
        frm.Show()
    End Try
    Try
        frm.Activate()
    Catch
    End Try
End Sub


' Envuelve el HWND de Inventor para poder mostrar el formulario como ventana
' hija suya. Sin esto la ventana se queda por detras y pierde el foco.
Public Class VentanaInventor
    Implements System.Windows.Forms.IWin32Window

    Private _identificador As System.IntPtr

    Public Sub New(identificador As System.IntPtr)
        _identificador = identificador
    End Sub

    Public ReadOnly Property Handle As System.IntPtr _
            Implements System.Windows.Forms.IWin32Window.Handle
        Get
            Return _identificador
        End Get
    End Property
End Class


