    ' ContextMenuStrip, MenuItem ni ToolStripMenuItem de forma directa para
    ' evitar errores de referencias en el compilador iLogic de Inventor 2026.
    Private menuResultados As Object
    Private mnuCopiarRuta As Object
    Private mnuCopiarFichero As Object
    Private mnuMover As Object
    Private mnuBorrar As Object
    Private mnuAbrirCarpeta As Object
    Private mnuAbrir As Object
