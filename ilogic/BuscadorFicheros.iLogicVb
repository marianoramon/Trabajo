    Private procesoRelaciones As System.Diagnostics.Process
    Private relojProcesoRelaciones As System.Windows.Forms.Timer
    Private relojOcultarProgreso As System.Windows.Forms.Timer
    Private carpetaRelacionesActiva As String = ""
    Private archivoProgresoRelaciones As String = ""
    Private archivoCancelarRelaciones As String = ""
    Private archivoErrorRelaciones As String = ""

    Private Function ProcesoRelacionesActivo() As Boolean
        Try
            Return procesoRelaciones IsNot Nothing AndAlso Not procesoRelaciones.HasExited
        Catch
            Return False
        End Try
    End Function

    Private Sub LanzarRelacionesEnSegundoInventor()
        If ProcesoRelacionesActivo() Then
            lblEstado.Text = "Las relaciones ya se estan actualizando. Puedes seguir trabajando."
            Return
        End If
        Try
            carpetaRelacionesActiva = CarpetaIndice()
            Dim archivoIndice As String = _archivoIndexadoEnCurso
            If archivoIndice = "" OrElse Not System.IO.File.Exists(archivoIndice) Then archivoIndice = ArchivoIndiceActual()
            If Not System.IO.File.Exists(archivoIndice) Then Throw New System.Exception("No existe el indice que se acaba de crear.")

            archivoProgresoRelaciones = System.IO.Path.Combine(System.IO.Path.GetTempPath(), "BuscadorRelaciones_" & System.Guid.NewGuid().ToString("N") & ".txt")
            archivoCancelarRelaciones = archivoProgresoRelaciones & ".cancelar"
            archivoErrorRelaciones = archivoProgresoRelaciones & ".error"
            Try
                If System.IO.File.Exists(archivoProgresoRelaciones) Then System.IO.File.Delete(archivoProgresoRelaciones)
                If System.IO.File.Exists(archivoCancelarRelaciones) Then System.IO.File.Delete(archivoCancelarRelaciones)
                If System.IO.File.Exists(archivoErrorRelaciones) Then System.IO.File.Delete(archivoErrorRelaciones)
            Catch
            End Try

            Dim inicio As New System.Diagnostics.ProcessStartInfo()
            inicio.FileName = System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.Windows), "System32\WindowsPowerShell\v1.0\powershell.exe")
            inicio.Arguments = "-NoProfile -NonInteractive -STA -EncodedCommand " & CODIGO_RELACIONES
            inicio.UseShellExecute = False
            inicio.CreateNoWindow = True
            inicio.WindowStyle = System.Diagnostics.ProcessWindowStyle.Hidden
            inicio.EnvironmentVariables("BUSCADOR_ARCHIVO_INDICE") = archivoIndice
            inicio.EnvironmentVariables("BUSCADOR_ARCHIVO_PROGRESO") = archivoProgresoRelaciones
            inicio.EnvironmentVariables("BUSCADOR_ARCHIVO_CANCELAR") = archivoCancelarRelaciones
            inicio.EnvironmentVariables("BUSCADOR_ARCHIVO_ERROR") = archivoErrorRelaciones
            procesoRelaciones = System.Diagnostics.Process.Start(inicio)

            If relojProcesoRelaciones Is Nothing Then
                relojProcesoRelaciones = New System.Windows.Forms.Timer()
                relojProcesoRelaciones.Interval = 500
                AddHandler relojProcesoRelaciones.Tick, AddressOf ComprobarRelaciones
            End If
            relojProcesoRelaciones.Start()
            btnIndexar.Enabled = False : btnActualizar.Enabled = False
            btnBuscar.Enabled = True : btnCancelar.Enabled = True
            HabilitarAccionesResultados(False)
            barraProgreso.Style = System.Windows.Forms.ProgressBarStyle.Blocks
            barraProgreso.Minimum = 0 : barraProgreso.Maximum = 100 : barraProgreso.Value = 0
            barraProgreso.Visible = True
            lblPorcentaje.Text = "0 %" : lblPorcentaje.Visible = True
            lblEstado.Text = "Relaciones: 0 %. Revisando ensamblajes nuevos o modificados. Puedes seguir trabajando."
        Catch ex As System.Exception
            btnIndexar.Enabled = True : btnActualizar.Enabled = True
            btnBuscar.Enabled = True : btnCancelar.Enabled = False
            lblEstado.Text = "No se pudo iniciar la actualizacion de relaciones: " & ex.Message
            OcultarProgresoEnBreve()
        End Try
    End Sub

    Private Sub ComprobarRelaciones(sender As Object, e As System.EventArgs)
        If procesoRelaciones Is Nothing Then Return
        Try
            If System.IO.File.Exists(archivoProgresoRelaciones) Then
                Dim textoProgreso As String = LeerArchivoCompartido(archivoProgresoRelaciones)
                Dim p As String() = textoProgreso.Split("|"c)
                Dim hechos As Integer : Dim total As Integer
                Dim cambiados As Integer : Dim totalCambios As Integer
                If p.Length >= 2 AndAlso Integer.TryParse(p(0), hechos) AndAlso Integer.TryParse(p(1), total) Then
                    If p.Length >= 4 Then
                        Integer.TryParse(p(2), cambiados) : Integer.TryParse(p(3), totalCambios)
                    End If
                    Dim porcentaje As Integer = If(totalCambios > 0, System.Math.Min(100, CInt(System.Math.Floor(CDbl(cambiados) * 100.0 / CDbl(totalCambios)))), 100)
                    barraProgreso.Minimum = 0 : barraProgreso.Maximum = 100 : barraProgreso.Value = porcentaje
                    lblPorcentaje.Text = porcentaje.ToString() & " %" : lblPorcentaje.Visible = True
                    lblEstado.Text = "Relaciones: " & porcentaje.ToString() & " % (" & cambiados.ToString() & " de " & totalCambios.ToString() & " IAM nuevos o modificados). Puedes seguir trabajando."
                End If
            End If
        Catch
        End Try
        If ProcesoRelacionesActivo() Then Return

        relojProcesoRelaciones.Stop()
        Dim codigo As Integer = -1
        Try : codigo = procesoRelaciones.ExitCode : Catch : End Try
        Try : procesoRelaciones.Dispose() : Catch : End Try
        procesoRelaciones = Nothing
        btnIndexar.Enabled = True : btnActualizar.Enabled = True
        btnBuscar.Enabled = True : btnCancelar.Enabled = False
        HabilitarAccionesResultados(True)
        cancelar = False
        If codigo = 0 Then
            barraProgreso.Maximum = 100 : barraProgreso.Value = 100
            lblPorcentaje.Text = "100 %" : lblPorcentaje.Visible = True
            lblEstado.Text = "Relaciones actualizadas: 100 %."
            If panelUsos IsNot Nothing Then panelUsos.CambiarCarpeta(carpetaRelacionesActiva, True)
        ElseIf codigo = 2 Then
            lblEstado.Text = "Actualizacion de relaciones cancelada."
        Else
            Dim detalle As String = ""
            Try
                If System.IO.File.Exists(archivoErrorRelaciones) Then detalle = System.IO.File.ReadAllText(archivoErrorRelaciones).Trim()
            Catch
            End Try
            If detalle.Contains(vbCr) Then detalle = detalle.Substring(0, detalle.IndexOf(vbCr))
            If detalle.Contains(vbLf) Then detalle = detalle.Substring(0, detalle.IndexOf(vbLf))
            If detalle.Length > 220 Then detalle = detalle.Substring(0, 220) & "..."
            lblEstado.Text = If(detalle = "", "No se pudieron completar las relaciones.", "Error de relaciones: " & detalle)
        End If
        LimpiarArchivosTemporalesRelaciones()
        OcultarProgresoEnBreve()
    End Sub

    Private Function LeerArchivoCompartido(ruta As String) As String
        Using flujo As New System.IO.FileStream(ruta, System.IO.FileMode.Open, System.IO.FileAccess.Read, System.IO.FileShare.ReadWrite Or System.IO.FileShare.Delete)
            Using lector As New System.IO.StreamReader(flujo, System.Text.Encoding.UTF8)
                Return lector.ReadToEnd()
            End Using
        End Using
    End Function

    Private Sub SolicitarCancelacionRelaciones()
        If Not ProcesoRelacionesActivo() Then Return
        Try
            System.IO.File.WriteAllText(archivoCancelarRelaciones, "cancelar")
        Catch
        End Try
    End Sub

    Private Sub LimpiarArchivosTemporalesRelaciones()
        Try
            If archivoProgresoRelaciones <> "" AndAlso System.IO.File.Exists(archivoProgresoRelaciones) Then System.IO.File.Delete(archivoProgresoRelaciones)
        Catch
        End Try
        Try
            If archivoCancelarRelaciones <> "" AndAlso System.IO.File.Exists(archivoCancelarRelaciones) Then System.IO.File.Delete(archivoCancelarRelaciones)
        Catch
        End Try
        Try
            If archivoErrorRelaciones <> "" AndAlso System.IO.File.Exists(archivoErrorRelaciones) Then System.IO.File.Delete(archivoErrorRelaciones)
        Catch
        End Try
    End Sub

    Private Sub OcultarProgresoEnBreve()
        If relojOcultarProgreso Is Nothing Then
            relojOcultarProgreso = New System.Windows.Forms.Timer()
            relojOcultarProgreso.Interval = 1500
            AddHandler relojOcultarProgreso.Tick, AddressOf OcultarProgresoFinal
        End If
        relojOcultarProgreso.Stop() : relojOcultarProgreso.Start()
    End Sub

    Private Sub OcultarProgresoFinal(sender As Object, e As System.EventArgs)
        relojOcultarProgreso.Stop()
        barraProgreso.Visible = False : lblPorcentaje.Visible = False
    End Sub

    Private Sub CerrarProcesoRelaciones()
        SolicitarCancelacionRelaciones()
        If relojProcesoRelaciones IsNot Nothing Then relojProcesoRelaciones.Stop() : relojProcesoRelaciones.Dispose()
        If relojOcultarProgreso IsNot Nothing Then relojOcultarProgreso.Stop() : relojOcultarProgreso.Dispose()
        If procesoRelaciones IsNot Nothing Then
            ' Sin esperar aqui, al reabrir el buscador se perderia la referencia y
            ' se lanzaria un segundo proceso escribiendo el mismo fichero .usos.
            Try
                procesoRelaciones.WaitForExit(3000)
            Catch
            End Try
            Try
                If Not procesoRelaciones.HasExited Then procesoRelaciones.Kill()
            Catch
            End Try
            Try : procesoRelaciones.Dispose() : Catch : End Try
            procesoRelaciones = Nothing
        End If
        LimpiarArchivosTemporalesRelaciones()
    End Sub

