    ' Etiqueta de cabecera de tabla: texto oscuro sobre ambar y clic para
    ' ordenar. El indice de columna viaja en Name porque Tag lo usa el tema.
    Private Function EtiquetaColumna(texto As String, columna As Integer, _
            x As Integer, w As Integer, _
            anclaje As System.Windows.Forms.AnchorStyles) As System.Windows.Forms.Label
        Dim l As New System.Windows.Forms.Label()
        l.Text = texto : l.Left = x : l.Top = 7 : l.Width = w
        l.Tag = "TEXTOACENTO" : l.Name = "COL" & columna.ToString()
        l.Anchor = anclaje
        l.Cursor = System.Windows.Forms.Cursors.Hand
        AddHandler l.Click, AddressOf OnCabeceraTablaClic
        Return l
    End Function

    Private Sub OnCabeceraTablaClic(sender As Object, e As System.EventArgs)
        Dim rotulo As System.Windows.Forms.Label = _
            TryCast(sender, System.Windows.Forms.Label)
        If rotulo Is Nothing Then Return
        Dim columna As Integer = 0
        If Not Integer.TryParse(rotulo.Name.Replace("COL", ""), columna) Then Return
        OrdenarPorColumna(columna)
    End Sub

