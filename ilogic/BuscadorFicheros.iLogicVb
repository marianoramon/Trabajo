    Public Sub New(app As Inventor.Application)
        oApp = app
        InicializarComponentes()
        Try
            System.Windows.Forms.Application.AddMessageFilter(Me)
        Catch
        End Try
    End Sub

    ' ================= TECLADO =================
    ' Inventor se queda con Intro y Escape cuando el formulario no es modal, asi
    ' que se cablean por cuatro vias distintas. Ninguna es imprescindible: la
    ' busqueda se lanza sola al teclear y la ventana se cierra con el boton X.

    ' Con un desplegable abierto, Escape debe cerrar el desplegable, no la ventana.
    Private Function DesplegableAbierto() As Boolean
        Try
            Dim combo As System.Windows.Forms.ComboBox = _
                TryCast(Me.ActiveControl, System.Windows.Forms.ComboBox)
            Return combo IsNot Nothing AndAlso combo.DroppedDown
        Catch
            Return False
        End Try
    End Function

    Protected Overrides Function ProcessCmdKey(ByRef msg As System.Windows.Forms.Message, _
            keyData As System.Windows.Forms.Keys) As Boolean
        If keyData <> System.Windows.Forms.Keys.Escape AndAlso _
                keyData <> System.Windows.Forms.Keys.Enter AndAlso _
                keyData <> System.Windows.Forms.Keys.Return Then
            Return MyBase.ProcessCmdKey(msg, keyData)
        End If
        Dim tecla As System.Windows.Forms.Keys = keyData And System.Windows.Forms.Keys.KeyCode
        If tecla = System.Windows.Forms.Keys.Escape AndAlso DesplegableAbierto() Then
            Return MyBase.ProcessCmdKey(msg, keyData)
        End If
        If tecla = System.Windows.Forms.Keys.Escape Then
            CerrarBuscador()
            Return True
        End If
        If tecla = System.Windows.Forms.Keys.Enter OrElse tecla = System.Windows.Forms.Keys.Return Then
            If txtCodigo IsNot Nothing AndAlso txtCodigo.Focused Then
                EjecutarBusquedaDesdeCodigo()
                Return True
            End If
        End If
        Return MyBase.ProcessCmdKey(msg, keyData)
    End Function

    Protected Overrides Function ProcessDialogKey(keyData As System.Windows.Forms.Keys) As Boolean
        Dim tecla As System.Windows.Forms.Keys = keyData And System.Windows.Forms.Keys.KeyCode
        If tecla = System.Windows.Forms.Keys.Escape Then
            CerrarBuscador()
            Return True
        End If
        If tecla = System.Windows.Forms.Keys.Enter OrElse tecla = System.Windows.Forms.Keys.Return Then
            If txtCodigo IsNot Nothing AndAlso txtCodigo.Focused Then
                EjecutarBusquedaDesdeCodigo()
                Return True
            End If
        End If
        Return MyBase.ProcessDialogKey(keyData)
    End Function

    Public Function PreFilterMessage(ByRef mensaje As System.Windows.Forms.Message) As Boolean _
            Implements System.Windows.Forms.IMessageFilter.PreFilterMessage
        Const WM_KEYDOWN As Integer = &H100
        If mensaje.Msg <> WM_KEYDOWN Then Return False
        If Not Me.Visible OrElse Me.IsDisposed Then Return False
        If System.Windows.Forms.Control.ModifierKeys <> System.Windows.Forms.Keys.None Then Return False
        Dim codigo As Long = mensaje.WParam.ToInt64()
        If codigo = CLng(System.Windows.Forms.Keys.Escape) Then
            If DesplegableAbierto() Then Return False
            If Me.ContainsFocus Then
                CerrarBuscador()
                Return True
            End If
            Return False
        End If
        If codigo <> CLng(System.Windows.Forms.Keys.Enter) Then Return False
        If txtCodigo Is Nothing OrElse Not txtCodigo.Focused Then Return False
        EjecutarBusquedaDesdeCodigo()
        Return True
    End Function

    Private Sub OnFormularioKeyDown(sender As Object, e As System.Windows.Forms.KeyEventArgs)
        If e.KeyCode = System.Windows.Forms.Keys.Escape Then
            e.Handled = True : e.SuppressKeyPress = True
            CerrarBuscador()
        ElseIf e.KeyCode = System.Windows.Forms.Keys.Enter Then
            If txtCodigo IsNot Nothing AndAlso txtCodigo.Focused Then
                e.Handled = True : e.SuppressKeyPress = True
                EjecutarBusquedaDesdeCodigo()
            End If
        End If
    End Sub

    Private Sub OnCodigoPreviewKeyDown(sender As Object, e As System.Windows.Forms.PreviewKeyDownEventArgs)
        If e.KeyCode = System.Windows.Forms.Keys.Enter OrElse e.KeyCode = System.Windows.Forms.Keys.Return Then
            e.IsInputKey = True
        End If
    End Sub

    Private Sub OnCodigoKeyDown(sender As Object, e As System.Windows.Forms.KeyEventArgs)
        If e.KeyCode = System.Windows.Forms.Keys.Enter OrElse e.KeyCode = System.Windows.Forms.Keys.Return Then
            EjecutarBusquedaDesdeCodigo()
            e.Handled = True
            e.SuppressKeyPress = True
        ElseIf e.KeyCode = System.Windows.Forms.Keys.Escape Then
            e.Handled = True
            e.SuppressKeyPress = True
            CerrarBuscador()
        End If
    End Sub

    Private Sub EjecutarBusquedaDesdeCodigo()
        If txtCodigo Is Nothing OrElse btnBuscar Is Nothing Then Return
        If Not btnBuscar.Enabled Then Return
        DetenerRelojBusqueda()
        OnBuscar(btnBuscar, System.EventArgs.Empty)
    End Sub

    Private Sub CerrarBuscador()
        If HayIndexacionActiva() Then cancelar = True
        Try
            Me.Close()
        Catch
        End Try
    End Sub

    ' ================= BUSQUEDA AUTOMATICA =================
    ' Es la via principal: no depende de que Inventor suelte la tecla Intro.
    Private Sub DetenerRelojBusqueda()
        If relojBusqueda IsNot Nothing Then relojBusqueda.Stop()
    End Sub

    Private Sub LiberarRelojBusqueda()
        If relojBusqueda Is Nothing Then Return
        Try
            relojBusqueda.Stop()
            relojBusqueda.Dispose()
        Catch
        End Try
        relojBusqueda = Nothing
    End Sub

    Private Sub OnCodigoTextChanged(sender As Object, e As System.EventArgs)
        If btnLimpiar IsNot Nothing Then btnLimpiar.Visible = (txtCodigo.Text.Length > 0)
        If relojBusqueda Is Nothing Then
            relojBusqueda = New System.Windows.Forms.Timer()
            relojBusqueda.Interval = RETARDO_BUSQUEDA
            AddHandler relojBusqueda.Tick, AddressOf OnBusquedaAutomatica
        End If
        relojBusqueda.Stop()
        If IndexandoAhora() Then Return
        If txtCodigo.Text.Trim().Length >= MINIMO_BUSQUEDA Then relojBusqueda.Start()
    End Sub

    Private Sub OnBusquedaAutomatica(sender As Object, e As System.EventArgs)
        relojBusqueda.Stop()
        If Me.IsDisposed OrElse cerradoDatos Then Return
        If IndexandoAhora() Then Return
        Dim codigo As String = txtCodigo.Text.Trim()
        If codigo.Length < MINIMO_BUSQUEDA Then Return
        If String.Equals(codigo, _codigoBusquedaActual, System.StringComparison.OrdinalIgnoreCase) Then Return
        If Not btnBuscar.Enabled Then Return
        _focoTrasResultados = False
        If panelUsos IsNot Nothing Then panelUsos.CambiarCarpeta(CarpetaIndice())
        PedirDatos(codigo)
    End Sub

    Private Sub OnLimpiarBusqueda(sender As Object, e As System.EventArgs)
        DetenerRelojBusqueda()
        txtCodigo.Text = ""
        txtCodigo.Select()
    End Sub

    ' ================= VENTANA SIN BORDES =================
    Private Sub OnArrastrarVentana(sender As Object, e As System.Windows.Forms.MouseEventArgs)
        If e.Button <> System.Windows.Forms.MouseButtons.Left Then Return
        If Me.WindowState = System.Windows.Forms.FormWindowState.Maximized Then Return
        Const WM_NCLBUTTONDOWN As Integer = &HA1
        Const HTCAPTION As Integer = 2
        Try
            ReleaseCapture()
            SendMessage(Me.Handle, WM_NCLBUTTONDOWN, HTCAPTION, 0)
        Catch
        End Try
    End Sub

    Private Sub OnRedimensionarVentana(sender As Object, e As System.Windows.Forms.MouseEventArgs)
        If e.Button <> System.Windows.Forms.MouseButtons.Left Then Return
        Const WM_NCLBUTTONDOWN As Integer = &HA1
        Const HTBOTTOMRIGHT As Integer = 17
        Try
            ReleaseCapture()
            SendMessage(Me.Handle, WM_NCLBUTTONDOWN, HTBOTTOMRIGHT, 0)
        Catch
        End Try
    End Sub

    Private Sub OnCabeceraDobleClic(sender As Object, e As System.Windows.Forms.MouseEventArgs)
        AlternarMaximizado()
    End Sub

    ' MinimumSize necesitaria un Size de System.Drawing, asi que se limita a mano.
    Private Sub OnLimitarTamano(sender As Object, e As System.EventArgs)
        If Me.WindowState <> System.Windows.Forms.FormWindowState.Normal Then Return
        If Me.Width < 980 Then Me.Width = 980
        If Me.Height < 560 Then Me.Height = 560
    End Sub

    Private Sub OnMinimizarVentana(sender As Object, e As System.EventArgs)
        Me.WindowState = System.Windows.Forms.FormWindowState.Minimized
    End Sub

    Private Sub OnMaximizarVentana(sender As Object, e As System.EventArgs)
        AlternarMaximizado()
    End Sub

    Private Sub AlternarMaximizado()
        If Me.WindowState = System.Windows.Forms.FormWindowState.Maximized Then
            Me.WindowState = System.Windows.Forms.FormWindowState.Normal
        Else
            Me.WindowState = System.Windows.Forms.FormWindowState.Maximized
        End If
    End Sub

    Private Sub OnCerrarVentana(sender As Object, e As System.EventArgs)
        CerrarBuscador()
    End Sub

    Private Function CarpetaConfig() As String
        Return System.IO.Path.Combine( _
            System.Environment.GetFolderPath(System.Environment.SpecialFolder.MyDocuments), _
            "BuscadorInventor")
    End Function

    ' ================= INTERFAZ =================
    Private Sub InicializarComponentes()
        Me.Text = "Buscador CAD - Indice de busqueda v7.9"
        ' El borde va PRIMERO: al cambiarlo despues, WinForms conserva el area
        ' cliente y la ventana se queda ~39 px mas corta, cortando las barras
        ' de abajo.
        Me.FormBorderStyle = System.Windows.Forms.FormBorderStyle.None
        Me.Width = 1320
        Me.Height = 742
        Me.StartPosition = System.Windows.Forms.FormStartPosition.CenterScreen
        Me.ShowInTaskbar = True
        Me.KeyPreview = True

        CrearCabecera()
        CrearBarraIndice()
        CrearCajaBusqueda()
        CrearFiltros()
        CrearListaResultados()
        CrearPanelUsos()
        CrearProgreso()
        CrearBarraAcciones()
        CrearBarraInferior()

        AddHandler Me.FormClosing, AddressOf OnFormularioClosing
        AddHandler Me.Shown, AddressOf OnFormularioShown
        AddHandler Me.Activated, AddressOf OnFormularioActivated
        AddHandler Me.KeyDown, AddressOf OnFormularioKeyDown
        AddHandler Me.Resize, AddressOf OnLimitarTamano
        AddHandler txtIndice.Validated, AddressOf OnIndiceValidado

        Me.AcceptButton = btnBuscar

        CargarAjustes()
        panelUsos.CambiarCarpeta(CarpetaIndice())
        AplicarTemaActual()
        ActualizarInfoIndice()
        ActualizarSeleccion()
    End Sub

    Private Function Etiqueta(texto As String, x As Integer, y As Integer, w As Integer) _
            As System.Windows.Forms.Label
        Dim l As New System.Windows.Forms.Label()
        l.Text = texto : l.Left = x : l.Top = y : l.Width = w
        Return l
    End Function

    Private Function EtiquetaTenue(texto As String, x As Integer, y As Integer, w As Integer) _
            As System.Windows.Forms.Label
        Dim l As System.Windows.Forms.Label = Etiqueta(texto, x, y, w)
        l.Tag = "TENUE"
        Return l
    End Function

    Private Function Boton(texto As String, x As Integer, y As Integer, w As Integer, _
            h As Integer, anclaje As System.Windows.Forms.AnchorStyles) As System.Windows.Forms.Button
        Dim b As New System.Windows.Forms.Button()
        b.Text = texto : b.Left = x : b.Top = y : b.Width = w : b.Height = h : b.Anchor = anclaje
        b.TabStop = False
        Return b
    End Function

    ' El TextBox va dentro de un panel que hace de caja. Asi el alto lo fijamos
    ' nosotros y ni el cambio de BorderStyle ni el de fuente pueden recortar el
    ' texto, que era lo que dejaba los campos a medias.
    Private Function CampoTexto(caja As System.Windows.Forms.TextBox, _
            x As Integer, y As Integer, w As Integer, h As Integer, _
            anclaje As System.Windows.Forms.AnchorStyles) As System.Windows.Forms.Panel
        Dim marco As New System.Windows.Forms.Panel()
        marco.Left = x : marco.Top = y : marco.Width = w : marco.Height = h
        marco.Tag = "CAMPO" : marco.Anchor = anclaje
        marco.Padding = New System.Windows.Forms.Padding(6, 3, 6, 3)
        caja.BorderStyle = System.Windows.Forms.BorderStyle.None
        caja.Dock = System.Windows.Forms.DockStyle.Fill
        marco.Controls.Add(caja)
        Return marco
    End Function

    Private Function Tarjeta(x As Integer, y As Integer, w As Integer, h As Integer, _
            marca As String, anclaje As System.Windows.Forms.AnchorStyles) As System.Windows.Forms.Panel
        Dim p As New System.Windows.Forms.Panel()
        p.Left = x : p.Top = y : p.Width = w : p.Height = h
        p.Tag = marca : p.Anchor = anclaje
        Return p
    End Function

