' =====================================================================
'  BUSCADOR DE FICHEROS EN LA RED  -  Regla iLogic para Autodesk Inventor
' =====================================================================
'
'  Busca piezas (.ipt) y ensamblajes (.iam) en la carpeta de red que
'  elijas, por el codigo que escribas, y permite abrirlos en Inventor.
'
'  - Puedes elegir la RUTA o la UNIDAD (P:\, etc.) en la parte superior.
'  - La busqueda se ejecuta en SEGUNDO PLANO para que NO se congele
'    Inventor; puedes Cancelar en cualquier momento.
'
'  NOTA: iLogic importa automaticamente el namespace "Inventor", que tiene
'  tipos con el mismo nombre que Windows Forms (Application, View, TextBox)
'  y un "Environment" propio. Por eso TODOS los tipos van cualificados con
'  su ruta completa (System.Windows.Forms..., System...) para evitar
'  errores de "es ambiguo".
' =====================================================================

' ----------------------- CODIGO PRINCIPAL ----------------------------
' iLogic exige que el codigo principal vaya dentro de Sub Main().

Sub Main()
    Dim frm As New BuscadorFicherosForm(ThisApplication)
    frm.ShowDialog()
End Sub


' ----------------------- VENTANA DEL BUSCADOR ------------------------

Public Class BuscadorFicherosForm
    Inherits System.Windows.Forms.Form

    ' Ruta por defecto donde buscar. EDITA esta linea si cambia tu unidad.
    Private Const RUTA_DEFECTO As String = "P:\"
    Private Const RUTA_RED As String = "\\192.168.10.217\DISEÑO"
    Private Const MAX_RESULTADOS As Integer = 500

    Private oApp As Inventor.Application

    Private txtRuta As System.Windows.Forms.TextBox
    Private btnExaminar As System.Windows.Forms.Button
    Private cboUnidad As System.Windows.Forms.ComboBox
    Private txtCodigo As System.Windows.Forms.TextBox
    Private rdoTodos As System.Windows.Forms.RadioButton
    Private rdoPiezas As System.Windows.Forms.RadioButton
    Private rdoEnsamblajes As System.Windows.Forms.RadioButton
    Private btnBuscar As System.Windows.Forms.Button
    Private btnCancelar As System.Windows.Forms.Button
    Private btnAbrir As System.Windows.Forms.Button
    Private lstResultados As System.Windows.Forms.ListView
    Private lblEstado As System.Windows.Forms.Label

    ' Estado de la busqueda en segundo plano.
    Private hiloBusqueda As System.Threading.Thread
    Private cancelar As Boolean = False
    Private _resultados As System.Collections.Generic.List(Of System.IO.FileInfo)
    Private _truncado As Boolean = False
    Private _codigoBuscado As String = ""

    Public Sub New(app As Inventor.Application)
        oApp = app
        InicializarComponentes()
    End Sub

    Private Sub InicializarComponentes()
        Me.Text = "Buscar ficheros en la red"
        Me.Width = 780
        Me.Height = 600
        Me.StartPosition = System.Windows.Forms.FormStartPosition.CenterScreen

        ' --- Fila 1: ruta donde buscar ---
        Dim lblRuta As New System.Windows.Forms.Label()
        lblRuta.Text = "Carpeta:"
        lblRuta.Left = 12 : lblRuta.Top = 16 : lblRuta.Width = 60
        Me.Controls.Add(lblRuta)

        txtRuta = New System.Windows.Forms.TextBox()
        txtRuta.Left = 78 : txtRuta.Top = 12 : txtRuta.Width = 560
        txtRuta.Anchor = System.Windows.Forms.AnchorStyles.Top _
            Or System.Windows.Forms.AnchorStyles.Left _
            Or System.Windows.Forms.AnchorStyles.Right
        txtRuta.Text = ObtenerRutaDefecto()
        Me.Controls.Add(txtRuta)

        btnExaminar = New System.Windows.Forms.Button()
        btnExaminar.Text = "Examinar..."
        btnExaminar.Left = 645 : btnExaminar.Top = 10 : btnExaminar.Width = 95 : btnExaminar.Height = 26
        btnExaminar.Anchor = System.Windows.Forms.AnchorStyles.Top _
            Or System.Windows.Forms.AnchorStyles.Right
        AddHandler btnExaminar.Click, AddressOf OnExaminar
        Me.Controls.Add(btnExaminar)

        ' --- Fila 2: unidad / ruta de red rapida ---
        Dim lblUnidad As New System.Windows.Forms.Label()
        lblUnidad.Text = "Unidad:"
        lblUnidad.Left = 12 : lblUnidad.Top = 48 : lblUnidad.Width = 60
        Me.Controls.Add(lblUnidad)

        cboUnidad = New System.Windows.Forms.ComboBox()
        cboUnidad.Left = 78 : cboUnidad.Top = 44 : cboUnidad.Width = 250
        cboUnidad.DropDownStyle = System.Windows.Forms.ComboBoxStyle.DropDownList
        cboUnidad.Items.Add("Ruta de red (" & RUTA_RED & ")")
        Try
            For Each d As System.IO.DriveInfo In System.IO.DriveInfo.GetDrives()
                cboUnidad.Items.Add(d.Name)
            Next
        Catch
        End Try
        AddHandler cboUnidad.SelectedIndexChanged, AddressOf OnUnidadChanged
        Me.Controls.Add(cboUnidad)

        ' --- Fila 3: codigo + boton buscar ---
        Dim lblCodigo As New System.Windows.Forms.Label()
        lblCodigo.Text = "Codigo a buscar:"
        lblCodigo.Left = 12 : lblCodigo.Top = 83 : lblCodigo.Width = 110
        Me.Controls.Add(lblCodigo)

        txtCodigo = New System.Windows.Forms.TextBox()
        txtCodigo.Left = 125 : txtCodigo.Top = 80 : txtCodigo.Width = 510
        txtCodigo.Anchor = System.Windows.Forms.AnchorStyles.Top _
            Or System.Windows.Forms.AnchorStyles.Left _
            Or System.Windows.Forms.AnchorStyles.Right
        AddHandler txtCodigo.KeyDown, AddressOf OnCodigoKeyDown
        Me.Controls.Add(txtCodigo)

        btnBuscar = New System.Windows.Forms.Button()
        btnBuscar.Text = "Buscar"
        btnBuscar.Left = 645 : btnBuscar.Top = 78 : btnBuscar.Width = 95 : btnBuscar.Height = 26
        btnBuscar.Anchor = System.Windows.Forms.AnchorStyles.Top _
            Or System.Windows.Forms.AnchorStyles.Right
        AddHandler btnBuscar.Click, AddressOf OnBuscar
        Me.Controls.Add(btnBuscar)

        ' --- Fila 4: filtro por tipo ---
        rdoTodos = New System.Windows.Forms.RadioButton()
        rdoTodos.Text = "Todos" : rdoTodos.Checked = True
        rdoTodos.Left = 125 : rdoTodos.Top = 112 : rdoTodos.Width = 70
        Me.Controls.Add(rdoTodos)

        rdoPiezas = New System.Windows.Forms.RadioButton()
        rdoPiezas.Text = "Piezas (.ipt)"
        rdoPiezas.Left = 200 : rdoPiezas.Top = 112 : rdoPiezas.Width = 110
        Me.Controls.Add(rdoPiezas)

        rdoEnsamblajes = New System.Windows.Forms.RadioButton()
        rdoEnsamblajes.Text = "Ensamblajes (.iam)"
        rdoEnsamblajes.Left = 315 : rdoEnsamblajes.Top = 112 : rdoEnsamblajes.Width = 150
        Me.Controls.Add(rdoEnsamblajes)

        ' --- Lista de resultados ---
        lstResultados = New System.Windows.Forms.ListView()
        lstResultados.Left = 12 : lstResultados.Top = 142
        lstResultados.Width = 740 : lstResultados.Height = 365
        lstResultados.View = System.Windows.Forms.View.Details
        lstResultados.FullRowSelect = True
        lstResultados.MultiSelect = False
        lstResultados.Anchor = System.Windows.Forms.AnchorStyles.Top _
            Or System.Windows.Forms.AnchorStyles.Bottom _
            Or System.Windows.Forms.AnchorStyles.Left _
            Or System.Windows.Forms.AnchorStyles.Right
        lstResultados.Columns.Add("Nombre", 230)
        lstResultados.Columns.Add("Tipo", 70)
        lstResultados.Columns.Add("Modificado", 120)
        lstResultados.Columns.Add("Ruta", 300)
        AddHandler lstResultados.DoubleClick, AddressOf OnAbrir
        Me.Controls.Add(lstResultados)

        ' --- Estado + botones ---
        lblEstado = New System.Windows.Forms.Label()
        lblEstado.Left = 12 : lblEstado.Top = 522 : lblEstado.Width = 360
        lblEstado.Anchor = System.Windows.Forms.AnchorStyles.Bottom _
            Or System.Windows.Forms.AnchorStyles.Left
        lblEstado.Text = "Listo. Ruta por defecto: " & txtRuta.Text
        Me.Controls.Add(lblEstado)

        btnCancelar = New System.Windows.Forms.Button()
        btnCancelar.Text = "Cancelar"
        btnCancelar.Left = 412 : btnCancelar.Top = 517 : btnCancelar.Width = 150 : btnCancelar.Height = 30
        btnCancelar.Enabled = False
        btnCancelar.Anchor = System.Windows.Forms.AnchorStyles.Bottom _
            Or System.Windows.Forms.AnchorStyles.Right
        AddHandler btnCancelar.Click, AddressOf OnCancelar
        Me.Controls.Add(btnCancelar)

        btnAbrir = New System.Windows.Forms.Button()
        btnAbrir.Text = "Abrir en Inventor"
        btnAbrir.Left = 572 : btnAbrir.Top = 517 : btnAbrir.Width = 180 : btnAbrir.Height = 30
        btnAbrir.Anchor = System.Windows.Forms.AnchorStyles.Bottom _
            Or System.Windows.Forms.AnchorStyles.Right
        AddHandler btnAbrir.Click, AddressOf OnAbrir
        Me.Controls.Add(btnAbrir)

        Me.AcceptButton = btnBuscar
    End Sub

    ' Ruta inicial: primera linea util de carpetas.txt, o RUTA_DEFECTO.
    Private Function ObtenerRutaDefecto() As String
        Try
            Dim cfg As String = System.IO.Path.Combine( _
                System.Environment.GetFolderPath(System.Environment.SpecialFolder.MyDocuments), _
                "BuscadorInventor", "carpetas.txt")
            If System.IO.File.Exists(cfg) Then
                For Each l As String In System.IO.File.ReadAllLines(cfg)
                    Dim t As String = l.Trim()
                    If t <> "" AndAlso Not t.StartsWith("#") Then Return t
                Next
            End If
        Catch
        End Try
        Return RUTA_DEFECTO
    End Function

    Private Sub OnExaminar(sender As Object, e As System.EventArgs)
        Dim dlg As New System.Windows.Forms.FolderBrowserDialog()
        dlg.Description = "Elige la carpeta donde buscar"
        Try
            If System.IO.Directory.Exists(txtRuta.Text.Trim()) Then
                dlg.SelectedPath = txtRuta.Text.Trim()
            End If
        Catch
        End Try
        If dlg.ShowDialog() = System.Windows.Forms.DialogResult.OK Then
            txtRuta.Text = dlg.SelectedPath
        End If
    End Sub

    Private Sub OnUnidadChanged(sender As Object, e As System.EventArgs)
        If cboUnidad.SelectedIndex = 0 Then
            txtRuta.Text = RUTA_RED
        ElseIf cboUnidad.SelectedIndex > 0 Then
            txtRuta.Text = cboUnidad.SelectedItem.ToString()
        End If
    End Sub

    Private Sub OnCodigoKeyDown(sender As Object, e As System.Windows.Forms.KeyEventArgs)
        If e.KeyCode = System.Windows.Forms.Keys.Enter Then
            OnBuscar(sender, e)
            e.SuppressKeyPress = True
        End If
    End Sub

    Private Function ExtensionesActivas() As System.Collections.Generic.List(Of String)
        Dim exts As New System.Collections.Generic.List(Of String)
        If rdoPiezas.Checked Then
            exts.Add(".ipt")
        ElseIf rdoEnsamblajes.Checked Then
            exts.Add(".iam")
        Else
            exts.Add(".ipt")
            exts.Add(".iam")
        End If
        Return exts
    End Function

    ' Lanza la busqueda en segundo plano (no congela Inventor).
    Private Sub OnBuscar(sender As Object, e As System.EventArgs)
        If hiloBusqueda IsNot Nothing AndAlso hiloBusqueda.IsAlive Then Return

        Dim codigo As String = txtCodigo.Text.Trim()
        If codigo = "" Then
            System.Windows.Forms.MessageBox.Show("Escribe un codigo para buscar.", "Buscador", _
                System.Windows.Forms.MessageBoxButtons.OK, _
                System.Windows.Forms.MessageBoxIcon.Information)
            Return
        End If

        Dim ruta As String = txtRuta.Text.Trim()
        If ruta = "" OrElse Not System.IO.Directory.Exists(ruta) Then
            System.Windows.Forms.MessageBox.Show("La carpeta no existe o no es accesible:" & _
                vbCrLf & ruta, "Buscador", _
                System.Windows.Forms.MessageBoxButtons.OK, _
                System.Windows.Forms.MessageBoxIcon.Warning)
            Return
        End If

        lstResultados.Items.Clear()
        lblEstado.Text = "Buscando en " & ruta & " ..."
        Me.Cursor = System.Windows.Forms.Cursors.WaitCursor
        cancelar = False
        btnBuscar.Enabled = False
        btnCancelar.Enabled = True

        Dim exts As System.Collections.Generic.List(Of String) = ExtensionesActivas()
        hiloBusqueda = New System.Threading.Thread(Sub() EjecutarBusqueda(ruta, codigo, exts))
        hiloBusqueda.IsBackground = True
        hiloBusqueda.Start()
    End Sub

    ' (Hilo en segundo plano) Recorre la carpeta y acumula resultados.
    Private Sub EjecutarBusqueda(ruta As String, codigo As String, _
            exts As System.Collections.Generic.List(Of String))
        _resultados = New System.Collections.Generic.List(Of System.IO.FileInfo)
        _truncado = False
        _codigoBuscado = codigo

        Try
            BuscarEnCarpeta(ruta, codigo.ToLower(), exts)
            _resultados.Sort(Function(a, b) b.LastWriteTime.CompareTo(a.LastWriteTime))
        Catch
        End Try

        Try
            If Me.IsHandleCreated AndAlso Not Me.IsDisposed Then
                Me.Invoke(New System.Action(AddressOf MostrarResultados))
            End If
        Catch
        End Try
    End Sub

    ' (Hilo en segundo plano) Busqueda recursiva segura ante permisos.
    Private Sub BuscarEnCarpeta(carpeta As String, codigoLower As String, _
            exts As System.Collections.Generic.List(Of String))
        If cancelar Then Return

        Dim ficheros() As String = Nothing
        Try
            ficheros = System.IO.Directory.GetFiles(carpeta)
        Catch
            Return
        End Try

        For Each f As String In ficheros
            If cancelar Then Return
            Dim ext As String = System.IO.Path.GetExtension(f).ToLower()
            If exts.Contains(ext) Then
                Dim nombre As String = System.IO.Path.GetFileNameWithoutExtension(f).ToLower()
                If nombre.Contains(codigoLower) Then
                    _resultados.Add(New System.IO.FileInfo(f))
                    If _resultados.Count >= MAX_RESULTADOS Then
                        _truncado = True
                        Return
                    End If
                End If
            End If
        Next

        Dim subcarpetas() As String = Nothing
        Try
            subcarpetas = System.IO.Directory.GetDirectories(carpeta)
        Catch
            Return
        End Try
        For Each sc As String In subcarpetas
            BuscarEnCarpeta(sc, codigoLower, exts)
            If _truncado OrElse cancelar Then Return
        Next
    End Sub

    ' (Hilo de UI) Vuelca los resultados en la lista al terminar.
    Private Sub MostrarResultados()
        lstResultados.Items.Clear()
        For Each fi As System.IO.FileInfo In _resultados
            Dim item As New System.Windows.Forms.ListViewItem(fi.Name)
            item.SubItems.Add(fi.Extension.ToUpper().Replace(".", ""))
            item.SubItems.Add(fi.LastWriteTime.ToString("yyyy-MM-dd HH:mm"))
            item.SubItems.Add(fi.FullName)
            item.Tag = fi.FullName
            lstResultados.Items.Add(item)
        Next

        Me.Cursor = System.Windows.Forms.Cursors.Default
        btnBuscar.Enabled = True
        btnCancelar.Enabled = False

        Dim msg As String
        If cancelar Then
            msg = "Busqueda cancelada. " & _resultados.Count.ToString() & " resultado(s) parcial(es)."
        Else
            msg = _resultados.Count.ToString() & " resultado(s) para """ & _codigoBuscado & """."
            If _truncado Then msg &= " (limitado a " & MAX_RESULTADOS & ", afina el codigo)"
        End If
        lblEstado.Text = msg

        If lstResultados.Items.Count > 0 Then
            lstResultados.Items(0).Selected = True
            lstResultados.Select()
        End If
    End Sub

    Private Sub OnCancelar(sender As Object, e As System.EventArgs)
        cancelar = True
        lblEstado.Text = "Cancelando..."
        btnCancelar.Enabled = False
    End Sub

    Private Sub OnAbrir(sender As Object, e As System.EventArgs)
        If lstResultados.SelectedItems.Count = 0 Then
            System.Windows.Forms.MessageBox.Show("Selecciona un fichero de la lista.", "Buscador", _
                System.Windows.Forms.MessageBoxButtons.OK, _
                System.Windows.Forms.MessageBoxIcon.Information)
            Return
        End If

        Dim ruta As String = lstResultados.SelectedItems(0).Tag.ToString()
        Try
            oApp.Documents.Open(ruta, True)
            Me.Close()
        Catch ex As System.Exception
            System.Windows.Forms.MessageBox.Show("No se pudo abrir el fichero:" & vbCrLf & ruta & _
                vbCrLf & vbCrLf & ex.Message, "Error al abrir", _
                System.Windows.Forms.MessageBoxButtons.OK, _
                System.Windows.Forms.MessageBoxIcon.Error)
        End Try
    End Sub

End Class
